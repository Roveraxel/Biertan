+## Taller grass clumps for meadows and forest edges (no stone).
+static func grass_clumps(p: Dictionary, at: Vector3, sc: float, rnd: NetRandom, count: int) -> void:
+	for _i in count:
+		var ang := rnd.f() * TAU
+		var dist := (0.5 + rnd.f() * 1.5) * sc
+		var c := at + Vector3(cos(ang) * dist, 0.0, sin(ang) * dist)
