+## A young spruce with sparse, upward boughs (for forest edges and clearings).
+static func spruce_young(p: Dictionary, at: Vector3, sc: float, rnd: NetRandom) -> void:
+	var h := (2.0 + rnd.f() * 1.0) * sc
+	limb(p.bark, at + Vector3.DOWN * 0.1, at + Vector3.UP * h * 0.85, 0.12 * sc, 0.04 * sc, 5)
+	var tiers := 3
+	for i in tiers:
+		var k := i / float(tiers - 1)
+		var y := lerpf(0.6, h * 0.8, k)
+		var r := lerpf(0.8, 0.25, k) * sc
+		var tier_h := lerpf(0.8, 0.5, k) * sc
+		var c := at + Vector3.UP * y
+		var apex := c + Vector3.UP * tier_h
+		var seg := 6
+		var twist := rnd.f() * PI
+		var mb: MeshBuilder = p.leaves if i % 2 == 0 else p.leaves2
+		var rim: Array[Vector3] = []
+		for j in seg:
+			var ang := twist + j * TAU / seg
+			var rr := r * (0.9 + rnd.f() * 0.15)
+			var droop := -0.15 * sc
+			rim.append(c + Vector3(cos(ang) * rr, droop, sin(ang) * rr))
+		for j in seg:
+			var q0 := rim[j]; var q1 := rim[(j + 1) % seg]
+			mb.tri(q0, q1, apex)
+
