+## Procedural haystacks in village meadows and near farms.
+## Placed in open grassy areas away from roads and buildings.
+static func _haystacks() -> void:
+	if not Mats.is_village(L.id): return
+	if L.id in ["stana"]: return   # Stâna has its own herd logic
+	
+	var map_m := L.size * S
+	var margin := 15.0
+	var noise := FastNoiseLite.new()
+	noise.noise_type = FastNoiseLite.TYPE_PERLIN
+	noise.fractal_octaves = 2
+	noise.frequency = 0.015
+	noise.seed = _str_hash(L.id) + 888
+	
+	# Find good open areas for haystacks (meadows, yards)
+	var candidates: Array[Vector3] = []
+	var step := 12.0
+	var x := -margin
+	while x < map_m.x + margin:
+		var z := -margin
+		while z < map_m.y + margin:
+			var nv := noise.get_noise_2d(x, z)
+			if nv > 0.35 and not _occupied_ground(Vector3(x, 0, -z)):
+				candidates.append(Vector3(x, 0, -z))
+			z += step
+		x += step
+	
+	if candidates.is_empty(): return
+	
+	# Place 3-6 haystacks per village, clustered in small groups
+	var rnd := NetRandom.new(_str_hash(L.id) & 0x7fffffff)
+	var count := 3 + rnd.i(4)
+	candidates.shuffle()
+	var placed := 0
+	var min_dist := 18.0
+	var placed_positions: Array[Vector3] = []
+	
+	for pos in candidates:
+		if placed >= count: break
+		var too_close := false
+		for pp in placed_positions:
+			if pos.distance_to(pp) < min_dist:
+				too_close = true
+				break
+		if too_close: continue
+		
+		# Add the haystack as decor (uses existing haystack sprite)
+		var p2d := Vector2(pos.x / S, -pos.z / S)
+		var d := L.add_decor(p2d, "haystack", 2.0, rnd.f() < 0.5)
+		if d:
+			placed_positions.append(pos)
+			placed += 1
+		# Also add a couple of haystack_plain nearby for variety
+		if rnd.f() < 0.4 and placed < count:
+			var near := pos + Vector3((rnd.f() - 0.5) * 6.0, 0, (rnd.f() - 0.5) * 6.0)
+			var np2d := Vector2(near.x / S, -near.z / S)
+			if not _occupied_ground(near):
+				var d2 := L.add_decor(np2d, "haystack_plain", 1.5, rnd.f() < 0.5)
+				if d2:
+					placed_positions.append(near)
+					placed += 1
+
