+## Blend two materials by lerping their albedo colors (for transitional ground patches).
+static func blend(a: Material, b: Material, t: float) -> StandardMaterial3D:
+	if not (a is StandardMaterial3D and b is StandardMaterial3D): return a
+	var key := "blend|%d|%d|%s" % [a.get_instance_id(), b.get_instance_id(), t]
+	if _cache.has(key): return _cache[key]
+	var m: StandardMaterial3D = a.duplicate()
+	var ca := a.albedo_color; var cb := b.albedo_color
+	m.albedo_color = ca.lerp(cb, t)
+	m.roughness = lerpf(a.roughness, b.roughness, t)
+	_cache[key] = m
+	return m
+
