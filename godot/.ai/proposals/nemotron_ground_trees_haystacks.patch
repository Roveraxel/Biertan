+## Procedural grass patches: irregular meadow clumps blended into the base ground.
+## Uses noise to place them naturally, more in villages and clearings, fewer in deep woods.
+static func _grass_patches() -> void:
+	if L.id in ["", "caves", "cellar", "crypt", "malcrypt", "tunnel", "gorge", "church", "sacristy"]: return
+	var village := Mats.is_village(L.id)
+	var deep := L.id in Mats.WOODS
+	if not village and not deep: return
+	
+	var grass_mat: Material = Mats.grass_meadow() if village else Mats.grass_wild()
+	var base_mat: Material = Mats.ground_for(L.id, L)
+	var map_m := L.size * S
+	var margin := 20.0
+	var spacing := 8.0 if village else 6.0
+	
+	# Sample noise for natural placement
+	var noise := FastNoiseLite.new()
+	noise.noise_type = FastNoiseLite.TYPE_PERLIN
+	noise.fractal_octaves = 3
+	noise.frequency = 0.018
+	noise.seed = _str_hash(L.id) + 777
+	
+	var holder := Node3D.new()
+	holder.name = "GrassPatches"
+	root.add_child(holder)
+	
+	var x := -margin
+	while x < map_m.x + margin:
+		var z := -margin
+		while z < map_m.y + margin:
+			var nv := noise.get_noise_2d(x, z)
+			if nv > 0.15:   # only place patches where noise is positive enough
+				var at3 := Vector3(x, 0.015, -z)
+				# Avoid placing on roads, cobbles, and building footprints
+				if not _occupied_ground(at3):
+					var b := Batch.new()
+					var patch_size := 4.0 + nv * 6.0
+					# Use blended material at edges for smoother transition
+					var mb := b.mb(grass_mat)
+					mb.disc(at3, patch_size * 0.6, patch_size * 0.4, randf() * PI, 16)
+					b.commit(holder, "Grass", false)
+			z += spacing
+		x += spacing
+
+## Check if a ground position is occupied by roads, cobbles, or buildings.
+static func _occupied_ground(pt: Vector3) -> bool:
+	var p2d := Vector2(pt.x / S, -pt.z / S)
+	# Check roads
+	for r in L.roads:
+		var pts: Array = r.pts
+		for i in pts.size() - 1:
+			var a: Vector2 = pts[i]; var b: Vector2 = pts[i + 1]
+			if dist_to_segment(p2d, a, b) < r.width * 0.6: return true
+	# Check cobbles
+	for c in L.cobbles:
+		if c.has_point(p2d): return true
+	# Check building footprints (with margin)
+	for b in L.blocks:
+		if b.style in ["hidden", "vine", "model", "wall", "stone", "rock", "ruin", "pew"]: continue
+		var w: float = b.size.x * S; var d: float = b.size.y * S
+		var local := _yaw(-b.angle).inverse() * (Vector3(pt.x, 0, pt.z) - u(b.c))
+		if absf(local.x) < w / 2.0 + 2.0 and local.z > -2.0 and local.z < d + 2.0: return true
+	return false
+
+## Simple deterministic hash for a string (for noise seeds).
+static func _str_hash(s: String) -> int:
+	var h := 0
+	for c in s:
+		h = (h * 31 + ord(c[0])) & 0x7fffffff
+	return h
